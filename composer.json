{
    "name": "vardumper/picocss-storybook",
    "type": "library",
    "description": "Storybook.js for PicoCSS",
    "keywords": [
        "storybook",
        "storybook.js",
        "pico",
        "picocss",
        "framework"
    ],
    "homepage": "https://github.com/vardumper/picocss-storybook",
    "license": "MIT",
    "require": {
        "bentools/cartesian-product": "^1.5.0",
        "fakerphp/faker": "^1.24.1",
        "matthiasmullie/minify": "^1.3.75",
        "mnapoli/silly": "^1.9.1",
        "symfony/yaml": "^7.3.5",
        "twig/intl-extra": "^3.22.0",
        "vardumper/extended-htmldocument": "^0.2.5",
        "picocss/pico": "dev-feature/base-on-html5-elements-refactor as 2.1.2"
    },
    "scripts": {
        "post-install-cmd": "vendor/bin/cghooks add --ignore-lock",
        "post-update-cmd": "vendor/bin/cghooks update",
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "phpmd": "phpmd src text ruleset.xml"
    },
    "require-dev": {
        "brainmaestro/composer-git-hooks": "dev-master",
        "friendsofphp/php-cs-fixer": "^3.89.1",
        "phpmd/phpmd": "^2.15",
        "symplify/easy-ci": "^12.1",
        "symplify/easy-coding-standard": "^12.6.2",
        "twig/twig": "^3.22.0"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4"
        },
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {
            "veewee/composer-run-parallel": true
        }
    },
    "extra": {
        "hooks": {
            "pre-commit": [
                ".hooks/pre-commit"
            ],
            "commit-msg": [
                ".hooks/commit-msg"
            ],
            "post-commit": [
                ".hooks/post-commit"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "PicoCSS\\Storybook\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Erik Pöhler",
            "email": "info@erikpoehler.com",
            "homepage": "https://erikpoehler.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/vardumper/extended-htmldocument"
        },
        {
            "type": "vcs",
            "url": "git@github.com:vardumper/pico.git"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
